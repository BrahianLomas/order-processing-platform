        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.environment.set(\"token\", jsonData.token);\r",
                  "    console.log(\"✅ Token guardado: \" + jsonData.token.substring(0, 20) + \"...\");\r",
                  "} else {\r",
                  "    console.log(\"❌ Error en login: \" + pm.response.code);\r",
                  "}"
