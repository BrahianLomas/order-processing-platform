# Copia este archivo a ".env" y complétalo con tus propios valores.
# ".env" está en .gitignore y nunca debe subirse al repositorio.

# Secreto para firmar/validar JWT (HS256). Debe ser el MISMO valor en
# api-gateway, order-service y payment-service, ya que los tres usan
# la misma clave simétrica para firmar (gateway) y validar (los demás).
JWT_SECRET=change-this-to-a-random-secret-at-least-256-bits-long

# Clave de API de Stripe (modo test). Solo la usa payment-service.
STRIPE_API_KEY=sk_test_your_own_test_key_here

# Password de MySQL (usuario root). Usada por los 4 servicios (api-gateway,
# order-service, payment-service, notification-service) y por MYSQL_ROOT_PASSWORD
# en docker-compose.yml — deben coincidir.
DB_PASSWORD=change-this-password
